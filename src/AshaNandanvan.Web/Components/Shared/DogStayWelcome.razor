<div class="stay-welcome">
    @if (ShowName)
    {
        <label>
            Your dog’s name
            <input value="@PetName"
                   maxlength="40"
                   autocomplete="off"
                   placeholder="e.g. Zeke"
                   @oninput="OnNameInput" />
        </label>
    }

    @{
        var letter = StayWelcomeCopy.Build(ShowName ? PetName : null);
    }
    <article class="stay-welcome__letter">
        <div class="stay-welcome__story">
            <div class="stay-welcome__copy">
                <p>@letter.Activity</p>
                <p>@letter.Flock</p>
                <h3>@letter.BringHeading</h3>
                <ul>
                    @foreach (var item in letter.Bring)
                    {
                        <li>@item</li>
                    }
                </ul>
                <h3>@letter.ShareHeading</h3>
                <ul>
                    @foreach (var item in letter.Share)
                    {
                        <li>@item</li>
                    }
                </ul>
                <h3>@letter.AfterHeading</h3>
                <ul>
                    @foreach (var item in letter.After)
                    {
                        <li>@item</li>
                    }
                </ul>
                <p>@letter.Close</p>
            </div>
            <figure class="stay-welcome__clip">
                <div class="stay-welcome__frame">
                    <iframe src="@YouTubeLinks.EmbedUrl(StayWelcomeCopy.AshaClipId)"
                            title="@letter.ClipCaption"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen></iframe>
                </div>
                <figcaption>@letter.ClipCaption</figcaption>
            </figure>
        </div>
    </article>
</div>

@code {
    [Parameter] public string PetName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PetNameChanged { get; set; }
    [Parameter] public bool ShowName { get; set; }

    private Task OnNameInput(ChangeEventArgs e) =>
        PetNameChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
