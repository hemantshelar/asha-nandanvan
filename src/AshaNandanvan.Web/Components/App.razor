<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AshaNandanvan.Web.styles.css"]" />
    <link rel="icon" type="image/png" href="@Assets["images/brand.png"]" />
    <link rel="apple-touch-icon" href="@Assets["images/brand.png"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        window.ashaScrollTo = function (id) {
            document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" });
        };
        window.ashaCopy = function (text) {
            return navigator.clipboard.writeText(text);
        };
        window.ashaVisit = function () {
            var read = function (name) {
                var found = document.cookie.split("; ").find(function (part) {
                    return part.indexOf(name + "=") === 0;
                });
                return found ? decodeURIComponent(found.substring(name.length + 1)) : "";
            };
            return { session: read("an_s"), width: window.innerWidth || 0 };
        };
        (function () {
            var dotNet = null;
            var infoOf = function (file) {
                if (!file) return null;
                return { name: file.name, size: file.size, type: file.type || "video/quicktime" };
            };
            var report = function (file) {
                window._ashaPickedFile = file || null;
                if (!dotNet) return;
                try { dotNet.invokeMethodAsync("OnVideoPicked", infoOf(file)); } catch (e) { }
            };
            window.ashaBindPicker = function (net) {
                dotNet = net;
            };
            window.ashaOnVideoInput = function (input) {
                report(input && input.files && input.files[0]);
            };
            window.ashaPeekPickedVideo = function () {
                return infoOf(window._ashaPickedFile);
            };
            window.ashaDropVideo = function (event) {
                event.preventDefault();
                event.stopPropagation();
                report(event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0]);
            };
        })();
        window.ashaYouTubeUpload = async function (sessionId, progressRef) {
            const file = window._ashaPickedFile;
            if (!file) throw new Error("Choose a video first.");
            if (file.size > 2 * 1024 * 1024 * 1024) throw new Error("Choose a video under 2 GB.");
            const chunkSize = /iP(hone|ad|od)/.test(navigator.userAgent) ? 2 * 1024 * 1024 : 8 * 1024 * 1024;
            let offset = 0;
            while (offset < file.size) {
                const end = Math.min(offset + chunkSize, file.size);
                const chunk = file.slice(offset, end);
                const response = await fetch("/admin/youtube/sessions/" + sessionId, {
                    method: "PUT",
                    headers: {
                        "Content-Range": "bytes " + offset + "-" + (end - 1) + "/" + file.size,
                        "Content-Type": "application/octet-stream"
                    },
                    credentials: "same-origin",
                    body: chunk
                });
                const data = await response.json().catch(function () { return {}; });
                if (!response.ok) throw new Error(data.message || "YouTube rejected this part of the upload.");
                offset = end;
                if (progressRef) {
                    try { await progressRef.invokeMethodAsync("Report", offset, file.size); } catch (e) { }
                }
                if (data.videoId) return data.videoId;
            }
            throw new Error("YouTube did not finish the upload.");
        };
    </script>
</body>

</html>
