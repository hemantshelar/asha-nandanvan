@page "/shop/{Slug}"
@inject IProductService Products
@inject IDogSittingService DogSitting
@inject IDogBreedService Breeds
@inject ICartService Cart
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_product?.Name ?? "Product") — Asha Nandanvan</PageTitle>

@if (_product is null)
{
    <section class="shell">
        <p>We could not find that item.</p>
        <a href="/">Back home</a>
    </section>
}
else
{
    @if (_product.Category == ProductCategory.DogSitting)
    {
        <section class="shell stay-book">
            <div class="stay-book__intro">
                <p class="eyebrow">@CatalogFormatting.CategoryName(_product.Category)</p>
                <h1>@(_settings?.Headline ?? _product.Name)</h1>
                <p class="lede">@(_settings?.Description ?? _product.Description)</p>
            </div>
            <div class="stay-book__grid">
                <DogStayWelcome />
                <div class="stay-book__card">
                    <img class="stay-book__photo" src="@_product.ImagePath" alt="@_product.Name" />
                    <p class="price">@CatalogFormatting.Money(_product.Price) <span>/ @_product.Unit</span></p>
                    <div class="stay-book__fields">
                        <label>
                            Dog's name
                            <input @bind="_petName" maxlength="40" autocomplete="off" placeholder="e.g. Zeke" required />
                        </label>
                        <label>
                            Drop-off
                            <input type="datetime-local" @bind="_dropOffLocal" @bind:after="OnDropOffChangedAsync" min="@_minLocal" />
                        </label>
                        <label>
                            Pick-up
                            <input type="datetime-local"
                                   value="@FormatLocal(_pickUpLocal)"
                                   @onchange="OnPickUpChangedAsync"
                                   min="@PickUpMinLocal" />
                        </label>
                        <label>
                            Breed
                            <select @bind="_breedChoice" @bind:after="CheckStayAsync" required>
                                <option value="">Choose a breed</option>
                                @foreach (var breed in _breeds)
                                {
                                    <option value="@breed.Name">@breed.Name</option>
                                }
                                <option value="@OtherBreed">Other / not listed</option>
                            </select>
                        </label>
                        @if (_breedChoice == OtherBreed)
                        {
                            <label class="stay-book__fields-span">
                                Breed not listed
                                <input @bind="_customBreed" @bind:after="CheckStayAsync" maxlength="80" autocomplete="off" placeholder="Type the breed" required />
                            </label>
                        }
                        @if (NeedsTrialBooking)
                        {
                            <label class="stay-book__fields-span">
                                Trial night
                                <input type="datetime-local"
                                       value="@FormatLocal(_trialLocal)"
                                       @onchange="OnTrialChangedAsync"
                                       min="@_minLocal"
                                       max="@TrialMaxLocal" />
                            </label>
                        }
                    </div>
                    <div class="stay-book__notes">
                    @if (BreedNotOffered)
                    {
                        <p class="banner banner--warn">@DogBreedCatalog.DeclinedMessage</p>
                    }
                    else if (BreedNeedsTrial)
                    {
                        <p class="banner">@DogBreedCatalog.LargeTrialMessage</p>
                    }
                    @if (_stayError is not null)
                    {
                        <p class="banner banner--warn">@_stayError</p>
                    }
                    else if (_availability is not null)
                    {
                        <p class="banner @(_availability.CanBook ? "banner--ok" : "banner--warn")">
                            <strong>@_availability.Status.</strong> @_availability.Message
                        </p>
                        @if (_availability.Warning is not null)
                        {
                            <p class="banner">@_availability.Warning</p>
                        }
                        <p class="muted stay-book__estimate">
                            @if (NeedsTrialBooking)
                            {
                                <text>Free trial night @_trialLocal?.ToString("ddd d MMM, h:mm tt") · @CatalogFormatting.Money(0). Then the long stay from @_dropOffLocal.ToString("ddd d MMM") if we both want to continue.</text>
                            }
                            else
                            {
                                <text>Estimated stay: @_nights night@(_nights == 1 ? "" : "s") · @CatalogFormatting.Money(_product.Price * _nights)</text>
                            }
                        </p>
                    }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_settings?.TermsAndConditions))
                    {
                        <details class="terms">
                            <summary>Terms and conditions</summary>
                            <p>@_settings.TermsAndConditions</p>
                        </details>
                        <label class="check">
                            <input type="checkbox" @bind="_acceptedTerms" />
                            I accept the dog sitting terms
                        </label>
                    }
                    <div class="qty-row">
                        <button class="btn btn--solid" disabled="@(!CanBookStay)" @onclick="AddStayAsync">
                            @(NeedsTrialBooking ? "Book free trial night" : "Book this stay")
                        </button>
                    </div>
                    <p><a class="text-link" href="/offer/@OfferCatalog.DogSitting.Slug">Back to dog sitting</a></p>
                </div>
            </div>
        </section>
    }
    else
    {
    <section class="shell product-detail">
        <img class="product-detail__image" src="@_product.ImagePath" alt="@_product.Name" />
        <div>
            <p class="eyebrow">@CatalogFormatting.CategoryName(_product.Category)</p>
            <h1>@_product.Name</h1>
            <p class="lede">@_product.Description</p>
            <p class="price">@CatalogFormatting.Money(_product.Price) <span>/ @_product.Unit</span></p>

            @if (_product.RequiresBooking)
            {
                <p class="muted">Pick an open date, then add it to your basket.</p>
                @if (_slots.Count == 0)
                {
                    <p class="banner">No dates are open yet. Please check back, or message us on Facebook, Instagram, or YouTube.</p>
                }
                else
                {
                    <div class="slot-list" role="list">
                        @foreach (var slot in _slots)
                        {
                            var taken = slot.Remaining <= 0;
                            <label class="slot @(taken ? "slot--full" : null) @(_slotId == slot.Id ? "slot--active" : null)">
                                <input type="radio" name="slot" value="@slot.Id" checked="@(_slotId == slot.Id)" disabled="@taken"
                                       @onchange="() => _slotId = slot.Id" />
                                <span>
                                    <strong>@slot.Label</strong>
                                    <small>@(taken ? "Fully booked" : $"{slot.Remaining} {_product.Unit} left")</small>
                                </span>
                            </label>
                        }
                    </div>
                }

                <div class="qty-row">
                    <MudNumericField @bind-Value="_quantity" Min="1" Max="@GuestMax" HideSpinButtons="false" Variant="Variant.Outlined" />
                    <button class="btn btn--solid" disabled="@(!CanBookSlot)" @onclick="AddAsync">Add to basket</button>
                </div>
            }
            else
            {
                <p class="muted">@_product.Stock in the backyard this week</p>
                <div class="qty-row">
                    <MudNumericField @bind-Value="_quantity" Min="1" Max="@Math.Max(1, _product.Stock)" HideSpinButtons="false" Variant="Variant.Outlined" />
                    <button class="btn btn--solid" disabled="@(_product.Stock <= 0)" @onclick="AddAsync">
                        Add to basket
                    </button>
                </div>
            }

            @{
                var offer = OfferCatalog.ForCategory(_product.Category);
            }
            @if (offer is not null)
            {
                <p><a class="text-link" href="/offer/@offer.Slug">Back to @offer.Title</a></p>
            }
        </div>
    </section>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private ProductListItem? _product;
    private DogSittingSettingsModel? _settings;
    private IReadOnlyList<ProductSlotItem> _slots = [];
    private int? _slotId;
    private int _quantity = 1;
    private DateTime _dropOffLocal = DateTime.Today.AddDays(1).AddHours(9);
    private DateTime? _pickUpLocal = DateTime.Today.AddDays(3).AddHours(18);
    private DateTime? _trialLocal;
    private string _minLocal = DateTime.Today.ToString("yyyy-MM-ddTHH:mm");
    private StayAvailability? _availability;
    private string? _stayError;
    private bool _acceptedTerms;
    private string _petName = string.Empty;
    private IReadOnlyList<DogBreedOption> _breeds = [];
    private string _breedChoice = string.Empty;
    private string _customBreed = string.Empty;
    private const string OtherBreed = "__other__";

    private string? ChosenBreed =>
        _breedChoice == OtherBreed ? _customBreed.Trim() : _breedChoice.Trim();

    private bool BreedNotOffered
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ChosenBreed))
            {
                return false;
            }

            var listed = _breeds.FirstOrDefault(b => b.Name.Equals(ChosenBreed, StringComparison.OrdinalIgnoreCase));
            return listed is not null ? !listed.OffersSitting : !DogBreedCatalog.OffersSitting(ChosenBreed);
        }
    }

    private bool BreedNeedsTrial
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ChosenBreed) || BreedNotOffered)
            {
                return false;
            }

            var listed = _breeds.FirstOrDefault(b => b.Name.Equals(ChosenBreed, StringComparison.OrdinalIgnoreCase));
            return listed is not null ? listed.IsLargeBreed : DogBreedCatalog.NeedsTrial(ChosenBreed);
        }
    }

    private bool NeedsTrialBooking => BreedNeedsTrial;

    private DateTime TrialLatest => _dropOffLocal.AddDays(-DogBreedCatalog.TrialLeadDays);

    private string TrialMaxLocal => TrialLatest.ToString("yyyy-MM-ddTHH:mm");

    private bool TrialDateValid =>
        _trialLocal is DateTime trial
        && trial.Date >= DateTime.Today
        && trial <= TrialLatest;

    private bool PickUpValid =>
        _pickUpLocal is DateTime pickUp && pickUp > _dropOffLocal;

    private string PickUpMinLocal => _dropOffLocal.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm");

    private int _nights =>
        _pickUpLocal is DateTime pickUp && pickUp > _dropOffLocal
            ? BookingPricing.NightCount(ToSydney(_dropOffLocal), ToSydney(pickUp))
            : 0;

    private int GuestMax
    {
        get
        {
            var slot = _slots.FirstOrDefault(s => s.Id == _slotId);
            return Math.Max(1, slot?.Remaining ?? 1);
        }
    }

    private bool CanBookSlot => _slotId is not null && _slots.Any(s => s.Id == _slotId && s.Remaining > 0);
    private bool CanBookStay =>
        _availability?.CanBook == true
        && _acceptedTerms
        && _stayError is null
        && !string.IsNullOrWhiteSpace(_petName)
        && !string.IsNullOrWhiteSpace(ChosenBreed)
        && !BreedNotOffered
        && PickUpValid
        && (!NeedsTrialBooking || TrialDateValid);

    protected override async Task OnParametersSetAsync()
    {
        _product = await Products.GetBySlugAsync(Slug);
        if (_product is null)
        {
            Navigation.NavigateTo("/not-found");
            return;
        }

        if (_product.Category == ProductCategory.DogSitting)
        {
            _settings = await DogSitting.GetSettingsAsync();
            _breeds = await Breeds.ListApprovedAsync();
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
                Navigation.ToAbsoluteUri(Navigation.Uri).Query);
            if (query.TryGetValue("pet", out var pet) && !string.IsNullOrWhiteSpace(pet) && string.IsNullOrWhiteSpace(_petName))
            {
                _petName = pet.ToString();
            }

            await CheckStayAsync();
            return;
        }

        if (_product.RequiresBooking)
        {
            _slots = await Products.GetSlotsAsync(_product.Id);
            _slotId = _slots.FirstOrDefault(s => s.Remaining > 0)?.Id;
            _quantity = 1;
        }
    }

    private Task OnDropOffChangedAsync()
    {
        if (_pickUpLocal is DateTime pickUp && pickUp <= _dropOffLocal)
        {
            _pickUpLocal = null;
        }

        if (_trialLocal is DateTime trial && trial > TrialLatest)
        {
            _trialLocal = null;
        }

        return CheckStayAsync();
    }

    private Task OnPickUpChangedAsync(ChangeEventArgs e)
    {
        _pickUpLocal = ParseLocal(e.Value);
        if (_pickUpLocal is DateTime pickUp && pickUp <= _dropOffLocal)
        {
            _pickUpLocal = null;
            _stayError = "Pick-up must be after drop-off.";
            _availability = null;
            return Task.CompletedTask;
        }

        return CheckStayAsync();
    }

    private Task OnTrialChangedAsync(ChangeEventArgs e)
    {
        _trialLocal = ParseLocal(e.Value);
        if (_trialLocal is DateTime trial && trial > TrialLatest)
        {
            _trialLocal = null;
            _stayError = "The trial night must be at least two days before drop-off.";
            _availability = null;
            return Task.CompletedTask;
        }

        return CheckStayAsync();
    }

    private async Task CheckStayAsync()
    {
        _stayError = null;
        _availability = null;
        try
        {
            if (!PickUpValid)
            {
                _stayError = "Pick-up must be after drop-off.";
                return;
            }

            if (_dropOffLocal < DateTime.Now.AddMinutes(-5))
            {
                _stayError = "Drop-off cannot be in the past.";
                return;
            }

            if (NeedsTrialBooking && TrialLatest.Date < DateTime.Today)
            {
                _stayError = "Drop-off is too soon for a trial night. Move the long stay at least two days later so we can meet first.";
                return;
            }

            if (NeedsTrialBooking && !TrialDateValid)
            {
                _stayError = "Choose a trial night at least two days before drop-off.";
                return;
            }

            var start = NeedsTrialBooking ? ToSydney(_trialLocal!.Value) : ToSydney(_dropOffLocal);
            var end = NeedsTrialBooking ? start.AddDays(1) : ToSydney(_pickUpLocal!.Value);
            _availability = await DogSitting.CheckAvailabilityAsync(start, end);
        }
        catch (Exception ex)
        {
            _stayError = ex.Message;
        }
    }

    private async Task AddStayAsync()
    {
        if (_product is null)
        {
            return;
        }

        try
        {
            var breed = await Breeds.ResolveForBookingAsync(ChosenBreed!);
            var trial = NeedsTrialBooking;
            if (!PickUpValid)
            {
                throw new InvalidOperationException("Pick-up must be after drop-off.");
            }

            if (trial && TrialLatest.Date < DateTime.Today)
            {
                throw new InvalidOperationException("Drop-off is too soon for a trial night. Move the long stay at least two days later so we can meet first.");
            }

            if (trial && !TrialDateValid)
            {
                throw new InvalidOperationException("Choose a trial night at least two days before drop-off.");
            }

            await Cart.AddAsync(
                _product.Id,
                1,
                stayStart: ToSydney(trial ? _trialLocal!.Value : _dropOffLocal),
                stayEnd: ToSydney(trial ? _trialLocal!.Value.AddDays(1) : _pickUpLocal!.Value),
                petName: _petName.Trim(),
                petBreed: breed,
                trialStay: trial,
                intendedStayStart: trial ? ToSydney(_dropOffLocal) : null,
                intendedStayEnd: trial ? ToSydney(_pickUpLocal!.Value) : null);
            Snackbar.Add(
                trial
                    ? $"{_petName.Trim()}'s free trial night added to your basket."
                    : $"{_petName.Trim()}'s stay added to your basket.",
                Severity.Success);
            _breeds = await Breeds.ListApprovedAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await CheckStayAsync();
        }
    }

    private async Task AddAsync()
    {
        if (_product is null)
        {
            return;
        }

        try
        {
            await Cart.AddAsync(_product.Id, _quantity, _product.RequiresBooking ? _slotId : null);
            Snackbar.Add($"{_product.Name} added to your basket.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private static string FormatLocal(DateTime? value) =>
        value is DateTime when ? when.ToString("yyyy-MM-ddTHH:mm") : string.Empty;

    private static DateTime? ParseLocal(object? value) =>
        DateTime.TryParse(value?.ToString(), out var when) ? when : null;

    private static DateTimeOffset ToSydney(DateTime local)
    {
        var unspecified = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
        var tz = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows() ? "AUS Eastern Standard Time" : "Australia/Sydney");
        return new DateTimeOffset(unspecified, tz.GetUtcOffset(unspecified));
    }
}
