@page "/cart"
@inject ICartService Cart
@inject NavigationManager Navigation

<PageTitle>Basket — Asha Nandanvan</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Your basket</p>
        <h1>Ready for pickup</h1>
    </div>
</section>

<section class="shell">
    @if (_cart.IsEmpty)
    {
        <p>Your basket is empty.</p>
        <a class="btn btn--solid" href="/shop">Browse the shop</a>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in _cart.Items)
                {
                    <tr>
                        <td>
                            <strong>@line.Name</strong>
                            <div class="muted">@CatalogFormatting.Money(line.UnitPrice) / @line.Unit</div>
                        </td>
                        <td>
                            <MudNumericField Value="line.Quantity" ValueChanged="(int q) => ChangeAsync(line.ProductId, q)" Min="1" Max="line.Stock" Variant="Variant.Outlined" />
                        </td>
                        <td>@CatalogFormatting.Money(line.LineTotal)</td>
                        <td><button class="text-link" @onclick="() => RemoveAsync(line.ProductId)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="cart-foot">
            <p>Total <strong>@CatalogFormatting.Money(_cart.Total)</strong></p>
            <button class="btn btn--solid" @onclick="Checkout">Checkout</button>
        </div>
    }
</section>

@code {
    private CartSnapshot _cart = new([]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _cart = await Cart.GetAsync();
            StateHasChanged();
        }
    }

    private async Task ChangeAsync(int productId, int quantity)
    {
        await Cart.UpdateQuantityAsync(productId, quantity);
        _cart = await Cart.GetAsync();
    }

    private async Task RemoveAsync(int productId)
    {
        await Cart.RemoveAsync(productId);
        _cart = await Cart.GetAsync();
    }

    private void Checkout() => Navigation.NavigateTo("/checkout");
}
