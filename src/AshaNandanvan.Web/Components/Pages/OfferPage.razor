@page "/offer/{Slug}"
@inject IProductService Products
@inject IMediaService MediaItems
@inject IStayPlanService StayPlans
@inject IOrderService Orders
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IVisitTracker Visits

<PageTitle>@(_offer?.Title ?? "Offer") — Asha Nandanvan</PageTitle>

@if (_offer is null)
{
    <section class="shell">
        <p>We could not find that offer.</p>
        <a href="/">Back home</a>
    </section>
}
else
{
    <section class="page-hero @(_offer.Slug == OfferCatalog.CompostTours.Slug ? "page-hero--tour" : null)">
        <div class="shell">
            <div class="page-hero__intro">
                <p class="eyebrow">@_offer.Eyebrow</p>
                <h1>@_offer.Title</h1>
                <hr class="page-hero__rule" />
                <p class="lede">@_offer.Description</p>
                @if (_pending is not null)
                {
                    <div class="pending-notice">
                        <p class="banner banner--warn">You already have a pending order @_pending.OrderNumber. Wait until we approve or reject it before placing another booking.</p>
                        <div class="page-hero__actions">
                            <a class="btn btn--solid" href="/orders">See my orders</a>
                        </div>
                    </div>
                }
                else if (_offer.Slug == OfferCatalog.CompostTours.Slug)
                {
                    <div class="page-hero__actions">
                        <button type="button" class="btn btn--solid" @onclick="ScrollToBookAsync">Book a date</button>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="shell">
        @if (_offer.Slug == OfferCatalog.CompostTours.Slug)
        {
            <CompostTourStory />
        }
        @if (_products.Count == 0)
        {
            <p class="muted">Nothing in this offer this week. Please check back soon.</p>
        }
        else if (_offer.Slug == OfferCatalog.DogSitting.Slug && _products.Count == 1)
        {
            <div class="stay-offer">
                <DogStayWelcome />
                @if (_pending is not null)
                {
                    <article class="product-card product-card--photo product-card--notice">
                        <div class="product-card__body">
                            <h3>@_products[0].Name</h3>
                            <div class="pending-notice">
                                <p class="banner banner--warn">Booking is paused while @_pending.OrderNumber is pending.</p>
                                <a class="btn btn--solid" href="/orders">See my orders</a>
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    <ProductCard Product="_products[0]" FromPrice="true" />
                }
            </div>
            @if (_plans.Count > 0)
            {
                <StayPlanCards Plans="_plans" />
            }
        }
        else if (_offer.Slug == OfferCatalog.CompostTours.Slug)
        {
            <div class="tour-book" id="book-tour">
                <p class="eyebrow">Join a session</p>
                <h2>Book a date</h2>
                <p class="lede">Pick a session and how many guests. We meet you at the gate and walk the three stops together.</p>
                @foreach (var product in _products)
                {
                    <article class="tour-book__panel">
                        <img class="tour-book__photo" src="@product.ImagePath" alt="@product.Name" />
                        <div class="tour-book__detail">
                            <p class="eyebrow">@CatalogFormatting.CategoryName(product.Category)</p>
                            <h3>@product.Name</h3>
                            <p>@product.Description</p>
                            <p class="tour-book__price">
                                @CatalogFormatting.Money(product.Price)
                                <span>/ @product.Unit</span>
                            </p>
                            @if (_pending is not null)
                            {
                                <a class="btn btn--solid" href="/orders">See my orders</a>
                            }
                            else
                            {
                                <a class="btn btn--solid" href="/shop/@product.Slug">Choose a date</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else if (_offer.RequiresBooking && _products.Count == 1)
        {
            @if (_pending is not null)
            {
                <div class="pending-notice">
                    <p class="banner banner--warn">Booking is paused while @_pending.OrderNumber is pending.</p>
                    <a class="btn btn--solid" href="/orders">See my orders</a>
                </div>
            }
            else
            {
                <p class="muted">Choose a date on the next screen, then add it to your basket.</p>
                <div class="product-grid">
                    <ProductCard Product="_products[0]" />
                </div>
            }
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in _products)
                {
                    <ProductCard Product="product" />
                }
            </div>
        }
    </section>

    @if (_clips.Count > 0)
    {
        <section class="band band--alt">
            <div class="shell">
                <p class="eyebrow section-kicker">From the backyard</p>
                <div class="section-head">
                    <h2>Media</h2>
                    <a class="text-link" href="/media?offer=@_offer.Slug">See all</a>
                </div>
                <p class="lede">What this offer looks like in the garden.</p>
                <MediaStrip Clips="_clips" Compact="true" />
            </div>
        </section>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private OfferDefinition? _offer;
    private IReadOnlyList<ProductListItem> _products = [];
    private IReadOnlyList<MediaClip> _clips = [];
    private IReadOnlyList<StayRatePlanView> _plans = [];
    private OrderSummary? _pending;

    protected override async Task OnParametersSetAsync()
    {
        _offer = OfferCatalog.Find(Slug);
        if (_offer is null)
        {
            Navigation.NavigateTo("/not-found");
            return;
        }

        var state = await Auth.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _pending = string.IsNullOrWhiteSpace(userId) ? null : await Orders.GetPendingForUserAsync(userId);

        if (_pending is not null && _offer.RequiresBooking)
        {
            await Visits.EventAsync(VisitEventKind.BookingBlockedPending, _pending.OrderNumber);
        }

        _products = await Products.GetActiveByOfferAsync(_offer.Slug);
        _clips = await MediaItems.ListAsync(_offer.Slug);
        _plans = _offer.Slug == OfferCatalog.DogSitting.Slug
            ? await StayPlans.ListAsync()
            : [];
    }

    private async Task ScrollToBookAsync() =>
        await Js.InvokeVoidAsync("ashaScrollTo", "book-tour");
}
