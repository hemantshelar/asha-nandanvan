@page "/checkout/confirmation/{OrderNumber}"
@attribute [Authorize]
@inject IOrderService Orders
@inject IPaymentProvider Payment
@inject IOptions<StoreOptions> StoreAccessor
@inject IOptions<PaymentOptions> PaymentAccessor
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Order @OrderNumber — Asha Nandanvan</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Thank you</p>
        <h1>@Heading</h1>
    </div>
</section>

<section class="shell">
    @if (_order is null)
    {
        <p>We could not find that order.</p>
    }
    else
    {
        <article class="panel">
            <p>Order <strong>@_order.OrderNumber</strong></p>
            <p>Status: <strong>@_order.StatusLabel</strong></p>
            <p>Visit / collect @_order.PickupDate.ToString("dddd d MMMM") · @_order.PickupWindow</p>
            <p>@Store.PickupAddress</p>
            @if (!string.IsNullOrWhiteSpace(_order.CustomerNote))
            {
                <p>@_order.CustomerNote</p>
            }
            else if (_order.Status.IsPending())
            {
                <p>This order is pending. We will approve it shortly. After that you can pay from <a href="/orders">My orders</a>.</p>
            }
            else if (_order.Status.IsApproved() && _order.CanPay)
            {
                <p>This order is approved. Pay online below, from <a href="/orders">My orders</a>, or in cash at the backyard.</p>
            }
            else if (_order.Status.IsApproved())
            {
                <p>This order is approved.</p>
            }
            else if (_order.Status.IsRejected())
            {
                <p>This order was rejected. Get in touch if you need another date.</p>
            }
            else if (_order.Status.IsPaid())
            {
                <p>This order is paid. Thank you.</p>
            }
            <ul>
                @foreach (var line in _order.Items)
                {
                    <li>
                        @line.Quantity × @line.ProductName
                        @if (!string.IsNullOrWhiteSpace(line.SlotLabel))
                        {
                            <text> (@line.SlotLabel)</text>
                        }
                        — @CatalogFormatting.Money(line.UnitPrice * line.Quantity)
                    </li>
                }
            </ul>
            <p class="total">Total @CatalogFormatting.Money(_order.Total)</p>
            @if (_order.CanPay)
            {
                <div class="pay-qr-block">
                    <img class="pay-qr" src="@_qrUri" alt="Pay QR for @_order.OrderNumber" />
                    <p class="muted">Scan to open the pay page, or keep this on your phone for the host.</p>
                </div>
                @if (!_needsSquareKeys)
                {
                    <button class="btn btn--solid" disabled="@_busy" @onclick="PayNowAsync">Pay this order online</button>
                }
            }
            <p><a class="text-link" href="/orders">See all my orders</a></p>
        </article>
    }
</section>

@code {
    [Parameter] public string OrderNumber { get; set; } = string.Empty;
    private OrderSummary? _order;
    private bool _busy;
    private string _qrUri = string.Empty;
    private string Heading =>
        _order is null ? "Order"
        : _order.HasTrialStay && _order.Status.IsApproved() ? "Trial night approved"
        : _order.HasTrialStay && _order.Status.IsPending() ? "Trial night requested"
        : _order.HasTrialStay && _order.Status.IsRejected() ? "Not continuing"
        : _order.Status.VisibleStatus() switch
        {
            OrderStatus.Placed => "Order placed",
            OrderStatus.Confirmed => "Order approved",
            OrderStatus.Rejected => "Order rejected",
            OrderStatus.Paid => "Order paid",
            _ => "Order"
        };
    private StoreOptions Store => StoreAccessor.Value;
    private bool _needsSquareKeys =>
        PaymentAccessor.Value.Provider.Equals("Square", StringComparison.OrdinalIgnoreCase)
        && !PaymentAccessor.Value.Square.IsConfigured;

    protected override async Task OnInitializedAsync()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        var sessionId = FirstQuery(query, "session_id", "orderId", "transactionId");

        await Payment.ConfirmReturnAsync(OrderNumber, sessionId);

        var state = await Auth.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var isAdmin = state.User.IsInRole(AppRoles.Admin);
        _order = await Orders.GetByNumberAsync(OrderNumber, userId, isAdmin);
        if (_order?.CanPay == true)
        {
            var payUrl = Navigation.ToAbsoluteUri($"/pay/{_order.OrderNumber}").ToString();
            _qrUri = QrImages.PngDataUri(payUrl);
        }
    }

    private async Task PayNowAsync()
    {
        if (_order is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var payment = await Payment.CreatePaymentAsync(PaymentFlow.ForOrder(_order, Store.Currency));
            Navigation.NavigateTo(payment.RedirectUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            _busy = false;
        }
    }

    private static string? FirstQuery(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> query, params string[] keys)
    {
        foreach (var key in keys)
        {
            if (query.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value))
            {
                return value.ToString();
            }
        }

        return null;
    }
}
