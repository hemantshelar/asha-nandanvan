@page "/admin/insights"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IInsightsService Insights
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Visitors — Admin</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Admin</p>
        <h1>Visitors</h1>
        <p class="lede">Who came to the site, how they found it, and what they did next.</p>
    </div>
</section>

<section class="shell">
    <form class="order-filters" @onsubmit:preventDefault>
        <label>
            Period
            <select @bind="_days" @bind:after="ReloadAsync">
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
                <option value="365">Last 12 months</option>
            </select>
        </label>
        <label>
            Crawlers
            <select @bind="_includeBots" @bind:after="ReloadAsync">
                <option value="false">Real people only</option>
                <option value="true">Include bots</option>
            </select>
        </label>
    </form>

    @if (_loading)
    {
        <p class="muted">Counting…</p>
    }
    else if (_report is null)
    {
        <p class="muted">No visit data yet.</p>
    }
    else
    {
        var r = _report;
        var t = r.Totals;

        <p class="muted">@r.From.ToString("d MMM yyyy") – @r.To.ToString("d MMM yyyy") · Sydney time</p>

        <div class="stat-grid">
            <article class="stat-card stat-card--lead">
                <span class="stat-card__label">Visits</span>
                <strong class="stat-card__value">@t.Visits.ToString("N0")</strong>
                <span class="stat-card__note">@t.PageViews.ToString("N0") page views</span>
            </article>
            <article class="stat-card">
                <span class="stat-card__label">Unique devices</span>
                <strong class="stat-card__value">@t.UniqueVisitors.ToString("N0")</strong>
                <span class="stat-card__note">@t.NewVisitors.ToString("N0") first-timers</span>
            </article>
            <article class="stat-card">
                <span class="stat-card__label">Unique networks</span>
                <strong class="stat-card__value">@t.UniqueNetworks.ToString("N0")</strong>
                <span class="stat-card__note">By IP — mobiles share these</span>
            </article>
            <article class="stat-card">
                <span class="stat-card__label">Pages per visit</span>
                <strong class="stat-card__value">@t.PagesPerVisit.ToString("0.0")</strong>
                <span class="stat-card__note">@Percent(t.BounceRate) left after one page</span>
            </article>
            <article class="stat-card">
                <span class="stat-card__label">Typical visit</span>
                <strong class="stat-card__value">@Duration(t.AverageSeconds)</strong>
                <span class="stat-card__note">@t.ReturningVisits.ToString("N0") return visits</span>
            </article>
            <article class="stat-card">
                <span class="stat-card__label">New sign-ups</span>
                <strong class="stat-card__value">@t.Registrations.ToString("N0")</strong>
                <span class="stat-card__note">Accounts created in this period</span>
            </article>
            <article class="stat-card @(t.OrdersPlaced > 0 ? "stat-card--good" : null)">
                <span class="stat-card__label">Orders placed</span>
                <strong class="stat-card__value">@t.OrdersPlaced.ToString("N0")</strong>
                <span class="stat-card__note">@Percent(t.VisitToOrderRate) of visits</span>
            </article>
            <article class="stat-card @(t.RevenuePaid > 0 ? "stat-card--good" : null)">
                <span class="stat-card__label">Paid</span>
                <strong class="stat-card__value">@CatalogFormatting.Money(t.RevenuePaid)</strong>
                <span class="stat-card__note">@CatalogFormatting.Money(t.RevenuePlaced) ordered</span>
            </article>
            <article class="stat-card @(t.BlockedByPendingOrder > 0 ? "stat-card--warn" : null)">
                <span class="stat-card__label">Booking blocked</span>
                <strong class="stat-card__value">@t.BlockedByPendingOrder.ToString("N0")</strong>
                <span class="stat-card__note">Hit the pending-order wall</span>
            </article>
            <article class="stat-card">
                <span class="stat-card__label">Crawlers</span>
                <strong class="stat-card__value">@t.BotVisits.ToString("N0")</strong>
                <span class="stat-card__note">Excluded unless you include them</span>
            </article>
        </div>

        <h2 class="section-heading">Visits per day</h2>
        @if (r.Trend.Count == 0)
        {
            <p class="muted">Nothing recorded yet.</p>
        }
        else
        {
            var peak = Math.Max(1, r.Trend.Max(point => point.Visits));
            <div class="chart-bars" role="img" aria-label="Visits per day">
                @foreach (var point in r.Trend)
                {
                    <div class="chart-bars__col" title="@point.Day.ToString("ddd d MMM"): @point.Visits visit@(point.Visits == 1 ? "" : "s"), @point.PageViews page views">
                        <span class="chart-bars__bar" style="height: @(Math.Round(point.Visits * 100.0 / peak))%"></span>
                        <span class="chart-bars__tick">@point.Day.Day</span>
                    </div>
                }
            </div>
        }

        <h2 class="section-heading">Where they came from</h2>
        @if (r.Sources.Count == 0)
        {
            <p class="muted">No sources yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Visits</th>
                            <th>Devices</th>
                            <th>Pages / visit</th>
                            <th>Left at once</th>
                            <th>Sign-ups</th>
                            <th>Orders</th>
                            <th>Paid</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var source in r.Sources)
                        {
                            <tr>
                                <td><strong>@source.Source</strong></td>
                                <td>@source.Visits.ToString("N0")</td>
                                <td>@source.UniqueVisitors.ToString("N0")</td>
                                <td>@source.PagesPerVisit.ToString("0.0")</td>
                                <td>@Percent(source.BounceRate)</td>
                                <td>@source.Registrations.ToString("N0")</td>
                                <td>@source.Orders.ToString("N0")</td>
                                <td>@(source.RevenuePaid > 0 ? CatalogFormatting.Money(source.RevenuePaid) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted">
                Facebook, Instagram and Gumtree usually strip the referrer, so tag the links you
                share. Anything arriving untagged and without a referrer lands in Direct.
            </p>
        }

        <h2 class="section-heading">From visit to paid</h2>
        <div class="funnel">
            @foreach (var step in r.Funnel)
            {
                var share = step.ShareOfTop(r.Funnel[0].Count);
                <div class="funnel__row">
                    <span class="funnel__label">@step.Label</span>
                    <span class="funnel__track"><span class="funnel__fill" style="width: @(Math.Round(share * 100, 1))%"></span></span>
                    <span class="funnel__value">@step.Count.ToString("N0") <small>@Percent(share)</small></span>
                </div>
            }
        </div>

        <h2 class="section-heading">What they browse on</h2>
        <div class="breakdown-grid">
            <article class="breakdown">
                <h3>Device</h3>
                @Bars(r.Devices, t.Visits)
            </article>
            <article class="breakdown">
                <h3>Browser</h3>
                @Bars(r.Browsers, t.Visits)
            </article>
            <article class="breakdown">
                <h3>Operating system</h3>
                @Bars(r.Platforms, t.Visits)
            </article>
            <article class="breakdown">
                <h3>Screen width</h3>
                @Bars(r.Viewports, t.Visits)
            </article>
        </div>

        <h2 class="section-heading">Busiest hours</h2>
        var busiest = Math.Max(1, r.Hours.Max(point => point.Visits));
        <div class="chart-bars chart-bars--hours" role="img" aria-label="Visits by hour of day">
            @foreach (var hour in r.Hours)
            {
                <div class="chart-bars__col" title="@HourLabel(hour.Hour): @hour.Visits visit@(hour.Visits == 1 ? "" : "s")">
                    <span class="chart-bars__bar" style="height: @(Math.Round(hour.Visits * 100.0 / busiest))%"></span>
                    <span class="chart-bars__tick">@(hour.Hour % 6 == 0 ? hour.Hour.ToString() : "")</span>
                </div>
            }
        </div>
        <p class="muted">Sydney time. Post when people are already looking.</p>

        <h2 class="section-heading">Most visited pages</h2>
        @if (r.Pages.Count == 0)
        {
            <p class="muted">No page views yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Page</th>
                            <th>Views</th>
                            <th>Visits</th>
                            <th>Arrived here</th>
                            <th>Left from here</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var seen in r.Pages)
                        {
                            <tr>
                                <td><a class="text-link" href="@seen.Path">@seen.Path</a></td>
                                <td>@seen.Views.ToString("N0")</td>
                                <td>@seen.Visits.ToString("N0")</td>
                                <td>@seen.Entries.ToString("N0")</td>
                                <td>@seen.Exits.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h2 class="section-heading">Latest visits</h2>
        @if (r.Recent.Count == 0)
        {
            <p class="muted">No visits yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Source</th>
                            <th>Landed on</th>
                            <th>Pages</th>
                            <th>Stayed</th>
                            <th>Device</th>
                            <th>Browser</th>
                            <th>System</th>
                            <th>Who</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visit in r.Recent)
                        {
                            <tr>
                                <td>@When(visit.At)</td>
                                <td>
                                    @visit.Source
                                    @if (visit.IsFirstVisit)
                                    {
                                        <div class="muted people-note">First time</div>
                                    }
                                </td>
                                <td>
                                    <a class="text-link" href="@visit.LandingPath">@visit.LandingPath</a>
                                    @if (visit.ExitPath is not null && visit.ExitPath != visit.LandingPath)
                                    {
                                        <div class="muted people-note">Left from @visit.ExitPath</div>
                                    }
                                </td>
                                <td>@visit.PageViews</td>
                                <td>@Duration(visit.Seconds)</td>
                                <td>
                                    @VisitSignals.DeviceLabel(visit.Device)
                                    @if (visit.ViewportWidth is int width)
                                    {
                                        <div class="muted people-note">@width px wide</div>
                                    }
                                </td>
                                <td>@Agent(visit.Browser, visit.BrowserVersion)</td>
                                <td>@Agent(visit.Platform, visit.PlatformVersion)</td>
                                <td>@(visit.Who ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h2 class="section-heading">Links to share</h2>
        <p class="muted">
            Use these instead of the bare address so each channel shows up separately above.
            Add <strong>?to=/offer/dog-sitting</strong> to land people straight on dog sitting.
        </p>
        <div class="table-scroll">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Where you are posting</th>
                        <th>Link to use</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var share in ShareCodes)
                    {
                        <tr>
                            <td>@share.Label</td>
                            <td><strong>@Origin/go/@share.Code</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private static readonly (string Label, string Code)[] ShareCodes =
    [
        ("Gumtree", "gt"),
        ("Facebook", "fb"),
        ("Instagram", "ig"),
        ("YouTube", "yt"),
        ("WhatsApp", "wa"),
        ("Printed flyer or QR code", "qr")
    ];

    private InsightsReport? _report;
    private bool _loading = true;
    private string _days = "30";
    private string _includeBots = "false";

    private string Origin => Navigation.BaseUri.TrimEnd('/');

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _report = await Insights.GetAsync(new InsightsQuery(
                int.TryParse(_days, out var days) ? days : 30,
                _includeBots == "true"));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment Bars(IReadOnlyList<InsightsBreakdownRow> rows, int total) => builder =>
    {
        if (rows.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "Nothing yet.");
            builder.CloseElement();
            return;
        }

        var sequence = 3;
        foreach (var row in rows.Take(6))
        {
            var share = total == 0 ? 0 : (double)row.Visits / total;

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "breakdown__row");

            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "breakdown__label");
            builder.AddContent(sequence++, row.Detail is null ? row.Label : $"{row.Label} {row.Detail}");
            builder.CloseElement();

            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "breakdown__track");
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "breakdown__fill");
            builder.AddAttribute(sequence++, "style", $"width: {Math.Round(share * 100, 1)}%");
            builder.CloseElement();
            builder.CloseElement();

            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "breakdown__value");
            builder.AddContent(sequence++, $"{row.Visits:N0}");
            builder.CloseElement();

            builder.CloseElement();
        }
    };

    private static string Percent(double share) => share.ToString("P0");

    private static string Duration(int seconds) => seconds switch
    {
        < 5 => "a glance",
        < 60 => $"{seconds}s",
        < 3600 => $"{seconds / 60}m {seconds % 60}s",
        _ => $"{seconds / 3600}h {seconds % 3600 / 60}m"
    };

    private static string Agent(string? name, string? version) =>
        string.IsNullOrWhiteSpace(name)
            ? "—"
            : string.IsNullOrWhiteSpace(version) ? name : $"{name} {version}";

    private static string HourLabel(int hour) => hour switch
    {
        0 => "12am",
        < 12 => $"{hour}am",
        12 => "12pm",
        _ => $"{hour - 12}pm"
    };

    private static string When(DateTimeOffset at) =>
        BookingPricing.ToSydney(at).ToString("d MMM, h:mm tt");
}
