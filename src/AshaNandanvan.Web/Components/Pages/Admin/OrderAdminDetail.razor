@page "/admin/orders/{OrderNumber}"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IOrderService Orders
@inject IPaymentProvider Payment
@inject IOptions<StoreOptions> StoreAccessor
@inject IOptions<PaymentOptions> PaymentAccessor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Order @OrderNumber — Admin</PageTitle>

<section class="page-hero page-hero--order">
    <div class="shell">
        <div class="order-desk__head">
            <div>
                <p class="eyebrow">Admin</p>
                <h1>@_order?.OrderNumber</h1>
                <p><a class="text-link" href="/admin/orders">Back to orders</a></p>
            </div>
            @if (_order is not null)
            {
                <span class="order-pill order-pill--@StatusTone(_order)">@_order.StatusLabel</span>
            }
        </div>
    </div>
</section>

<section class="shell">
    @if (_order is null)
    {
        <p>Order was not found.</p>
    }
    else
    {
        <div class="order-desk @(_order.CanPay ? null : "order-desk--solo")">
            <article class="panel order-desk__main">
                <div class="order-desk__facts">
                    <div>
                        <p class="eyebrow">Customer</p>
                        <strong>@_order.CustomerName</strong>
                        <p class="muted">@_order.CustomerEmail</p>
                        @if (!string.IsNullOrWhiteSpace(_order.Phone))
                        {
                            <p class="muted">@_order.Phone</p>
                        }
                    </div>
                    <div>
                        <p class="eyebrow">Visit</p>
                        <strong>@_order.PickupDate.ToString("dddd d MMMM")</strong>
                        <p class="muted">@_order.PickupWindow</p>
                    </div>
                    <div>
                        <p class="eyebrow">Payment</p>
                        <strong>@PaymentLabel</strong>
                        @if (!string.IsNullOrWhiteSpace(_order.PaymentReference))
                        {
                            <p class="muted">@_order.PaymentReference</p>
                        }
                    </div>
                </div>
                <ul class="order-sheet__items">
                    @foreach (var line in _order.Items)
                    {
                        <li>
                            <span>@line.Quantity × @line.ProductName</span>
                            <span>@CatalogFormatting.Money(line.UnitPrice * line.Quantity)</span>
                            @if (!string.IsNullOrWhiteSpace(line.StayPlanName))
                            {
                                <small class="muted">@(line.IsCompanionDog ? "Companion" : "Lead dog") · @line.StayPlanName</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.SlotLabel))
                            {
                                <small class="muted">@line.SlotLabel</small>
                            }
                            @if (line.IsTrialStay && line.IntendedStayStartsAt is not null && line.IntendedStayEndsAt is not null)
                            {
                                <small class="muted">Wanted stay: @StayRange(line.IntendedStayStartsAt.Value, line.IntendedStayEndsAt.Value)</small>
                            }
                        </li>
                    }
                </ul>
                <p class="order-desk__total">
                    <span>Total</span>
                    <span>@CatalogFormatting.Money(_order.Total)</span>
                </p>
                @if (HasDecisionActions || _order.CanPay || _order.AlbumId is not null)
                {
                    <div class="order-desk__actions">
                        @if (_order.CanApprove)
                        {
                            <button class="btn btn--solid" type="button" disabled="@_busy" @onclick="ApproveAsync">Approve</button>
                        }
                        @if (_order.CanPlaceOriginalStay)
                        {
                            <button class="btn btn--solid" type="button" disabled="@_busy" @onclick="PlaceOriginalAsync">Place original order</button>
                        }
                        @if (_order.CanPay)
                        {
                            <button class="btn btn--ghost" type="button" disabled="@_busy" @onclick="MarkCashAsync">Mark paid (cash)</button>
                            <button class="btn btn--solid" type="button" disabled="@(_busy || _needsSquareKeys)" @onclick="StartOnlineAsync">Start online pay</button>
                        }
                        @if (_order.AlbumId is int albumId)
                        {
                            <a class="btn btn--ghost" href="/albums/@albumId">Open album</a>
                        }
                        @if (_order.CanReject)
                        {
                            <button class="btn btn--ghost" type="button" disabled="@_busy" @onclick="RejectAsync">Reject</button>
                        }
                        @if (_order.CanDeclineLongerStay)
                        {
                            <button class="btn btn--ghost" type="button" disabled="@_busy" @onclick="DeclineLongerStayAsync">Do not continue</button>
                        }
                    </div>
                }
            </article>
            @if (_order.CanPay)
            {
                <aside class="panel order-desk__pay">
                    <p class="eyebrow">Customer pay</p>
                    <h2>Show this QR</h2>
                    <p class="muted">They scan it, open the pay page, and finish on Square.</p>
                    <div class="pay-qr-block">
                        <img class="pay-qr" src="@_qrUri" alt="Payment QR for @_order.OrderNumber" />
                    </div>
                    <p class="order-desk__amount">@CatalogFormatting.Money(_order.Total)</p>
                    <p class="muted order-desk__url">@_payUrl</p>
                </aside>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string OrderNumber { get; set; } = string.Empty;
    private OrderSummary? _order;
    private bool _busy;
    private string _payUrl = string.Empty;
    private string _qrUri = string.Empty;
    private StoreOptions Store => StoreAccessor.Value;
    private bool _needsSquareKeys =>
        PaymentAccessor.Value.Provider.Equals("Square", StringComparison.OrdinalIgnoreCase)
        && !PaymentAccessor.Value.Square.IsConfigured;
    private bool HasDecisionActions =>
        _order is { CanApprove: true } or { CanReject: true } or { CanPlaceOriginalStay: true } or { CanDeclineLongerStay: true };
    private string PaymentLabel =>
        _order is null ? string.Empty
        : _order.Status.IsPaid() ? (_order.PaymentProvider is { Length: > 0 } paid ? paid : "Paid")
        : _order.PaymentStarted ? "Checkout started, not finished"
        : "Waiting";

    private static string StatusTone(OrderSummary order) =>
        order.Status.IsRejected() ? "no"
        : order.Status.IsApproved() || order.Status.IsPaid() ? "ok"
        : "wait";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await ConfirmStartedCheckoutAsync();
    }

    // A checkout may have been paid without the customer returning to us. Ask the provider
    // once on load so we show Paid instead of offering the QR a second time.
    private async Task ConfirmStartedCheckoutAsync()
    {
        if (_order is null || !_order.PaymentStarted || !_order.Status.IsApproved())
        {
            return;
        }

        try
        {
            await Payment.ConfirmReturnAsync(_order.OrderNumber, null);
            await ReloadAsync();
        }
        catch
        {
            // Leave the order as it is; the admin can still mark it paid by hand.
        }
    }

    private async Task ReloadAsync()
    {
        _order = await Orders.GetByNumberAsync(OrderNumber, admin: true);
        if (_order is null)
        {
            return;
        }

        _payUrl = Navigation.ToAbsoluteUri($"/pay/{_order.OrderNumber}").ToString();
        _qrUri = QrImages.PngDataUri(_payUrl);
    }

    private async Task ApproveAsync() =>
        await RunAsync(() => Orders.ApproveAsync(_order!.Id), "Order approved.");

    private async Task RejectAsync() =>
        await RunAsync(() => Orders.RejectAsync(_order!.Id), "Order rejected.");

    private async Task PlaceOriginalAsync() =>
        await RunAsync(() => Orders.PlaceOriginalStayAsync(_order!.Id), "Longer stay approved. The customer can pay as usual.");

    private async Task DeclineLongerStayAsync() =>
        await RunAsync(() => Orders.RejectAsync(_order!.Id), "We will not continue with the longer stay.");

    private async Task RunAsync(Func<Task> action, string ok)
    {
        if (_order is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await action();
            Snackbar.Add(ok, Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StayRange(DateTimeOffset start, DateTimeOffset end)
    {
        var dropOff = start.ToOffset(BookingPricing.SydneyOffset(start));
        var pickUp = end.ToOffset(BookingPricing.SydneyOffset(end));
        return $"{dropOff:ddd d MMM} – {pickUp:ddd d MMM}";
    }

    private async Task MarkCashAsync()
    {
        if (_order is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Orders.MarkPaidAsync(_order.OrderNumber, "cash", "Cash");
            Snackbar.Add("Marked as paid in cash.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartOnlineAsync()
    {
        if (_order is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var payment = await Payment.CreatePaymentAsync(PaymentFlow.ForOrder(_order, Store.Currency));
            Navigation.NavigateTo(payment.RedirectUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _busy = false;
        }
    }
}
