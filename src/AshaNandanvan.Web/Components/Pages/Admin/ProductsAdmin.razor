@page "/admin/products"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IProductService Products

<PageTitle>Products — Admin</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Admin</p>
        <div class="page-hero__row">
            <h1>Products</h1>
            <a class="btn btn--solid" href="/admin/products/edit">Add product</a>
        </div>
    </div>
</section>

<section class="shell">
    <div class="table-scroll">
        <table class="cart-table cart-table--stack">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr>
                        <td data-label="Name">@product.Name</td>
                        <td data-label="Category">@CatalogFormatting.CategoryName(product.Category)</td>
                        <td data-label="Price">@CatalogFormatting.Money(product.Price)</td>
                        <td data-label="Stock">@product.Stock @product.Unit</td>
                        <td data-label="Active">@(product.IsActive ? "Yes" : "No")</td>
                        <td data-label=""><a class="text-link" href="/admin/products/edit/@product.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IReadOnlyList<ProductListItem> _products = [];

    protected override async Task OnInitializedAsync()
    {
        _products = await Products.GetAllAsync();
    }
}
