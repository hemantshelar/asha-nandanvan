@page "/admin/products/edit"
@page "/admin/products/edit/{Id:int}"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IProductService Products
@inject IImageStorage Images
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(Id.HasValue ? "Edit product" : "Add product") — Admin</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Admin</p>
        <h1>@(Id.HasValue ? "Edit product" : "Add product")</h1>
    </div>
</section>

<section class="shell">
    <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label>
            Name
            <input @bind="_model.Name" required />
        </label>
        <label>
            Description
            <textarea @bind="_model.Description" rows="5" required></textarea>
        </label>
        <label>
            Category
            <select @bind="_category">
                <option value="@ProductCategory.Eggs">Eggs (fresh produce)</option>
                <option value="@ProductCategory.Veggies">Veggies (fresh produce)</option>
                <option value="@ProductCategory.WormsAndCompost">Worms &amp; compost</option>
                <option value="@ProductCategory.DogSitting">Dog sitting (booking)</option>
                <option value="@ProductCategory.CompostTour">Composting tour (booking)</option>
            </select>
        </label>
        <label>
            Price (AUD)
            <input type="number" step="0.01" min="0" @bind="_model.Price" required />
        </label>
        <label>
            Stock
            <input type="number" min="0" @bind="_model.Stock" required />
        </label>
        <label>
            Unit
            <input @bind="_model.Unit" required />
        </label>
        <label class="check">
            <input type="checkbox" @bind="_model.IsActive" />
            Active in the shop
        </label>
        <label>
            Photo
            <InputFile OnChange="OnFile" accept="image/*" />
        </label>
        @if (!string.IsNullOrWhiteSpace(_model.ImagePath))
        {
            <img class="preview" src="@_model.ImagePath" alt="" />
        }
        <button class="btn btn--solid" type="submit" disabled="@_busy">Save</button>
    </form>

    @if (Id is int productId && _category == ProductCategory.CompostTour)
    {
        <section class="slot-admin">
            <h2>Booking dates</h2>
            <p class="muted">Visitors pick one of these before they can add this to the basket.</p>
            @if (_slots.Count == 0)
            {
                <p class="muted">No dates yet.</p>
            }
            else
            {
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Capacity</th>
                            <th>Booked</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in _slots)
                        {
                            <tr>
                                <td>@slot.Label</td>
                                <td>@slot.Capacity</td>
                                <td>@slot.BookedCount</td>
                                <td>
                                    <button class="text-link" type="button" @onclick="() => RemoveSlotAsync(slot.Id)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <form class="admin-form" @onsubmit="AddSlotAsync" @onsubmit:preventDefault>
                <label>
                    Starts
                    <input type="datetime-local" @bind="_slotStart" />
                </label>
                <label>
                    Ends
                    <input type="datetime-local" @bind="_slotEnd" />
                </label>
                <label>
                    Capacity
                    <input type="number" min="1" @bind="_slotCapacity" />
                </label>
                <label>
                    Label (optional)
                    <input @bind="_slotLabel" placeholder="Weekend stay, Saturday 10am…" />
                </label>
                <button class="btn btn--ghost" type="submit">Add date</button>
            </form>
        </section>
    }
</section>

@code {
    [Parameter] public int? Id { get; set; }
    private readonly ProductEditModel _model = new();
    private ProductCategory _category = ProductCategory.Veggies;
    private bool _busy;
    private IReadOnlyList<ProductSlotItem> _slots = [];
    private DateTime _slotStart = DateTime.Today.AddDays(7).AddHours(10);
    private DateTime _slotEnd = DateTime.Today.AddDays(7).AddHours(11).AddMinutes(30);
    private int _slotCapacity = 1;
    private string? _slotLabel;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null)
        {
            return;
        }

        var product = await Products.GetByIdAsync(Id.Value);
        if (product is null)
        {
            Navigation.NavigateTo("/admin/products");
            return;
        }

        _model.Id = product.Id;
        _model.Name = product.Name;
        _model.Description = product.Description;
        _model.Category = product.Category;
        _category = product.Category;
        _model.Price = product.Price;
        _model.Stock = product.Stock;
        _model.Unit = product.Unit;
        _model.ImagePath = product.ImagePath;
        _model.IsActive = product.IsActive;
        if (product.Category.RequiresBooking())
        {
            _slots = await Products.GetSlotsAsync(product.Id, upcomingOnly: false);
            _slotCapacity = product.Category == ProductCategory.DogSitting ? 1 : 8;
        }
    }

    private async Task OnFile(InputFileChangeEventArgs args)
    {
        await using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
        _model.ImagePath = await Images.SaveAsync(stream, args.File.Name);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _model.Category = _category;
        try
        {
            if (Id is null)
            {
                await Products.CreateAsync(_model);
            }
            else
            {
                _model.Id = Id.Value;
                await Products.UpdateAsync(_model);
            }

            Navigation.NavigateTo("/admin/products");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _busy = false;
        }
    }

    private async Task AddSlotAsync()
    {
        if (Id is null)
        {
            return;
        }

        try
        {
            await Products.CreateSlotAsync(new ProductSlotEditModel
            {
                ProductId = Id.Value,
                StartsAt = ToSydney(_slotStart),
                EndsAt = ToSydney(_slotEnd),
                Capacity = _slotCapacity,
                Label = _slotLabel
            });
            _slotLabel = null;
            _slots = await Products.GetSlotsAsync(Id.Value, upcomingOnly: false);
            Snackbar.Add("Date added.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveSlotAsync(int slotId)
    {
        if (Id is null)
        {
            return;
        }

        await Products.DeactivateSlotAsync(slotId);
        _slots = await Products.GetSlotsAsync(Id.Value, upcomingOnly: false);
    }

    private static DateTimeOffset ToSydney(DateTime local)
    {
        var unspecified = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
        var tz = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows() ? "AUS Eastern Standard Time" : "Australia/Sydney");
        return new DateTimeOffset(unspecified, tz.GetUtcOffset(unspecified));
    }
}
