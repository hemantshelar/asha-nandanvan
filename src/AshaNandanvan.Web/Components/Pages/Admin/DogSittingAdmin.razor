@page "/admin/dog-sitting"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IDogSittingService DogSitting
@inject ISnackbar Snackbar

<PageTitle>Dog sitting — Admin</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Admin</p>
        <h1>Dog sitting</h1>
        <p class="lede">Capacity, public copy, and terms. Visitors pick their own drop-off and pick-up.</p>
    </div>
</section>

<section class="shell">
    <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label>
            Maximum dogs at one time
            <input type="number" min="1" max="50" @bind="_model.MaxDogs" required />
        </label>
        <label>
            Price per night (AUD)
            <input type="number" step="0.01" min="0" @bind="_model.PricePerNight" required />
        </label>
        <label>
            Headline
            <input @bind="_model.Headline" required />
        </label>
        <label>
            Description
            <textarea @bind="_model.Description" rows="6" required></textarea>
        </label>
        <label>
            Terms and conditions
            <textarea @bind="_model.TermsAndConditions" rows="8" required></textarea>
        </label>
        <button class="btn btn--solid" type="submit" disabled="@_busy">Save</button>
    </form>
</section>

@code {
    private DogSittingSettingsModel _model = new();
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _model = await DogSitting.GetSettingsAsync();
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await DogSitting.SaveSettingsAsync(_model);
            Snackbar.Add("Dog sitting settings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
