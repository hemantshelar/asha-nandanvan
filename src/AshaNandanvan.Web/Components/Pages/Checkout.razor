@page "/checkout"
@attribute [Authorize]
@inject ICartService Cart
@inject IOrderService Orders
@inject IPaymentProvider Payment
@inject IOptions<StoreOptions> StoreAccessor
@inject IOptions<PaymentOptions> PaymentAccessor
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Checkout — Asha Nandanvan</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Sydney backyard</p>
        <h1>Checkout</h1>
        <p class="lede">Place the order now and pay later — cash or online after the visit — or pay now to settle it immediately.</p>
    </div>
</section>

<section class="shell checkout">
    @if (_cancelled)
    {
        <p class="banner">Payment was cancelled. Your basket is still here if you started pay-now.</p>
    }

    @if (_cart.IsEmpty)
    {
        <p>Your basket is empty.</p>
        <a class="btn btn--solid" href="/#offers">See what we offer</a>
    }
    else
    {
        <div class="checkout__grid">
            <form @onsubmit:preventDefault>
                <label>
                    Name
                    <input @bind="_request.CustomerName" required />
                </label>
                <label>
                    Email
                    <input type="email" @bind="_request.CustomerEmail" required />
                </label>
                <label>
                    Phone (optional, useful if we need to confirm)
                    <input @bind="_request.Phone" />
                </label>
                <label>
                    Pickup or visit date
                    <input type="date" value="@_request.PickupDate.ToString("yyyy-MM-dd")" @onchange="OnDate" min="@DateOnly.FromDateTime(DateTime.Today.AddDays(1)).ToString("yyyy-MM-dd")" required />
                </label>
                <label>
                    Pickup window
                    <select @bind="_request.PickupWindow">
                        @foreach (var window in Store.PickupWindows)
                        {
                            <option value="@window">@window</option>
                        }
                    </select>
                </label>
                <p class="muted">@Store.PickupAddress</p>
                <div class="checkout-choice">
                    <p><strong>Place order</strong> — we hold the produce or stay. Pay later in cash, from your orders, or by scanning a QR the host shows you.</p>
                    <p><strong>Pay and place order</strong> — settle online now on Square.</p>
                </div>
                @if (_needsSquareKeys)
                {
                    <p class="banner">Online pay needs Square keys. You can still place the order and pay later.</p>
                }
                else
                {
                    <p class="muted">@_paymentHint</p>
                }
                <div class="checkout__actions">
                    <button class="btn btn--ghost" type="button" disabled="@_busy" @onclick="() => SubmitAsync(payNow: false)">Place order</button>
                    <button class="btn btn--solid" type="button" disabled="@(_busy || _needsSquareKeys)" @onclick="() => SubmitAsync(payNow: true)">Pay and place order</button>
                </div>
            </form>
            <aside class="panel">
                <h2>Order</h2>
                @foreach (var line in _cart.Items)
                {
                    <p>
                        @line.Quantity × @line.Name
                        @if (!string.IsNullOrWhiteSpace(line.SlotLabel))
                        {
                            <small class="muted"> · @line.SlotLabel</small>
                        }
                        <span>@CatalogFormatting.Money(line.LineTotal)</span>
                    </p>
                }
                <p class="total">Total @CatalogFormatting.Money(_cart.Total)</p>
            </aside>
        </div>
    }
</section>

@code {
    private CartSnapshot _cart = new([]);
    private readonly CheckoutRequest _request = new();
    private bool _busy;
    private bool _cancelled;
    private StoreOptions Store => StoreAccessor.Value;
    private bool _needsSquareKeys =>
        PaymentAccessor.Value.Provider.Equals("Square", StringComparison.OrdinalIgnoreCase)
        && !PaymentAccessor.Value.Square.IsConfigured;
    private string _paymentHint => Payment.Name switch
    {
        "Mock" => "Online pay is in demo mode and will mark the order paid immediately.",
        "Square (sandbox)" => "Online pay uses Square sandbox. Test card 4111 1111 1111 1111, any future expiry, any CVV, any postcode.",
        "Square" => "Online pay finishes on the secure Square page.",
        _ => "Online pay finishes on the secure payment page."
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _cancelled = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).ContainsKey("cancelled");

        var state = await Auth.GetAuthenticationStateAsync();
        _request.CustomerEmail = state.User.Identity?.Name ?? string.Empty;
        _request.CustomerName = state.User.Identity?.Name?.Split('@')[0] ?? string.Empty;
        _request.PickupDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        _request.PickupWindow = Store.PickupWindows.FirstOrDefault() ?? Store.PickupHours;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _cart = await Cart.GetAsync();
            StateHasChanged();
        }
    }

    private void OnDate(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            _request.PickupDate = date;
        }
    }

    private async Task SubmitAsync(bool payNow)
    {
        if (string.IsNullOrWhiteSpace(_request.CustomerName) || string.IsNullOrWhiteSpace(_request.CustomerEmail))
        {
            Snackbar.Add("Name and email are needed.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? throw new InvalidOperationException("Please sign in again.");

            var order = await Orders.CreateOrderAsync(userId, _request, payNow);
            if (!payNow)
            {
                await Cart.ClearAsync();
                Navigation.NavigateTo($"/checkout/confirmation/{order.OrderNumber}");
                return;
            }

            var payment = await Payment.CreatePaymentAsync(PaymentFlow.ForOrder(order, Store.Currency));
            Navigation.NavigateTo(payment.RedirectUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            _busy = false;
        }
    }
}
