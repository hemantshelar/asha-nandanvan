@page "/media"
@inject IMediaService MediaItems
@inject ISnackbar Snackbar

<PageTitle>Media — Asha Nandanvan</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">From the backyard</p>
        <h1>Media</h1>
        <div class="media-hero__row">
            <p class="lede">Clips from the garden, grouped the same way as what we offer.</p>
            <AuthorizeView Roles="@AppRoles.Admin">
                <button class="btn btn--solid" type="button" @onclick="StartAdd">Add clip</button>
            </AuthorizeView>
        </div>
    </div>
</section>

<section class="shell">
    <div class="filters">
        <a class="chip @Active(null)" href="/media">All</a>
        @foreach (var offer in OfferCatalog.All)
        {
            <a class="chip @Active(offer.Slug)" href="/media?offer=@offer.Slug">@offer.Eyebrow</a>
        }
    </div>

    <AuthorizeView Roles="@AppRoles.Admin">
        @if (_formOpen)
        {
            <form class="admin-form panel media-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <h2>@(_model.Id is int ? "Edit clip" : "Add clip")</h2>
                <label>
                    YouTube link
                    <input @bind="_model.SourceUrl" placeholder="https://youtu.be/your-video" required />
                </label>
                <label>
                    Title
                    <input @bind="_model.Title" placeholder="Optional — we can name it after the offer" />
                </label>
                <label>
                    Offer
                    <select @bind="_model.OfferSlug" required>
                        @foreach (var offer in OfferCatalog.All)
                        {
                            <option value="@offer.Slug">@offer.Title</option>
                        }
                    </select>
                </label>
                <label>
                    Sort order
                    <input type="number" @bind="_model.SortOrder" />
                </label>
                <label class="check">
                    <input type="checkbox" @bind="_model.IsPublished" />
                    Published
                </label>
                <button class="btn btn--solid" type="submit" disabled="@_busy">Save</button>
                <button class="btn btn--ghost" type="button" disabled="@_busy" @onclick="CancelForm">Cancel</button>
            </form>
        }
    </AuthorizeView>

    @if (_clips.Count == 0)
    {
        <p class="muted">
            <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                <Authorized>No clips in this group yet. Add a YouTube link to get started.</Authorized>
                <NotAuthorized>No clips in this group yet.</NotAuthorized>
            </AuthorizeView>
        </p>
    }
    else
    {
        <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
            <Authorized>
                <MediaStrip Clips="_clips" CanManage="true" Edit="StartEdit" Delete="DeleteAsync" />
            </Authorized>
            <NotAuthorized>
                <MediaStrip Clips="_clips" />
            </NotAuthorized>
        </AuthorizeView>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "offer")] public string? Offer { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<MediaClip> _clips = [];
    private bool _isAdmin;
    private bool _formOpen;
    private bool _busy;
    private bool _adminResolved;
    private string? _listKey;
    private MediaEditModel _model = NewModel(null);

    protected override async Task OnParametersSetAsync()
    {
        if (!_adminResolved && AuthState is not null)
        {
            var state = await AuthState;
            _isAdmin = state.User.IsInRole(AppRoles.Admin);
            _adminResolved = true;
        }

        var key = $"{_isAdmin}|{CurrentSlug()}";
        if (_listKey == key)
        {
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var slug = CurrentSlug();
        _listKey = $"{_isAdmin}|{slug}";
        _clips = await MediaItems.ListAsync(slug, publishedOnly: !_isAdmin);
    }

    private string? CurrentSlug()
    {
        var slug = string.IsNullOrWhiteSpace(Offer) ? null : Offer.Trim();
        return slug is not null && OfferCatalog.Find(slug) is not null ? slug : null;
    }

    private void StartAdd()
    {
        _model = NewModel(CurrentSlug());
        _formOpen = true;
    }

    private void StartEdit(MediaClip clip)
    {
        _model = new MediaEditModel
        {
            Id = clip.Id,
            OfferSlug = clip.OfferSlug,
            Title = clip.Title,
            SourceUrl = clip.WatchUrl,
            SortOrder = clip.SortOrder,
            IsPublished = clip.IsPublished
        };
        _formOpen = true;
    }

    private void CancelForm()
    {
        _formOpen = false;
        _model = NewModel(CurrentSlug());
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await MediaItems.SaveAsync(_model);
            Snackbar.Add(_model.Id is int ? "Clip saved." : "Clip added.", Severity.Success);
            _formOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(MediaClip clip)
    {
        try
        {
            await MediaItems.DeleteAsync(clip.Id);
            if (_model.Id == clip.Id)
            {
                CancelForm();
            }

            Snackbar.Add("Clip deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private string Active(string? slug) =>
        string.Equals(Offer, slug, StringComparison.OrdinalIgnoreCase)
        || (slug is null && string.IsNullOrWhiteSpace(Offer))
            ? "chip--active"
            : string.Empty;

    private static MediaEditModel NewModel(string? offerSlug) => new()
    {
        OfferSlug = offerSlug ?? OfferCatalog.FreshProduce.Slug,
        IsPublished = true
    };
}
