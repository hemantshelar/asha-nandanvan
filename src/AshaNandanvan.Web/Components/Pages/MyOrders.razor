@page "/orders"
@attribute [Authorize]
@inject IOrderService Orders
@inject IPaymentProvider Payment
@inject IOptions<StoreOptions> StoreAccessor
@inject IOptions<PaymentOptions> PaymentAccessor
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_isAdmin ? "All orders" : "My orders") — Asha Nandanvan</PageTitle>

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">@(_isAdmin ? "Admin" : "Your account")</p>
        <h1>@(_isAdmin ? "All orders" : "My orders")</h1>
        <p class="lede">
            @if (_isAdmin)
            {
                <text>Approve or reject each order. After you approve a trial, place the original stay. Customers pay only after approval.</text>
            }
            else
            {
                <text>Once we approve an order, you can pay online or in cash at the backyard.</text>
            }
        </p>
    </div>
</section>

<section class="shell">
    @if (_source.Count == 0)
    {
        <p>@(_isAdmin ? "No orders yet." : "You have no orders yet.")</p>
        @if (!_isAdmin)
        {
            <a class="btn btn--solid" href="/#offers">See what we offer</a>
        }
    }
    else
    {
        <form class="order-filters" @onsubmit:preventDefault>
            <label>
                Order number
                <input @bind="_orderNumber" @bind:event="oninput" placeholder="AN-…" />
            </label>
            @if (_isAdmin)
            {
                <label>
                    First name
                    <input @bind="_firstName" @bind:event="oninput" placeholder="Substring" />
                </label>
                <label>
                    Email
                    <input @bind="_email" @bind:event="oninput" placeholder="name@@example.com" />
                </label>
                <label>
                    Phone
                    <input @bind="_phone" @bind:event="oninput" placeholder="04…" />
                </label>
            }
            <label>
                Status
                <select @bind="_status">
                    <option value="">Any status</option>
                    @foreach (var status in OrderStatusExtensions.FilterChoices)
                    {
                        <option value="@status">@CatalogFormatting.StatusName(status)</option>
                    }
                </select>
            </label>
            <label>
                Visit from
                <input type="date" @bind="_fromDate" />
            </label>
            @if (_isAdmin)
            {
                <label>
                    Stay type
                    <select @bind="_trialFilter">
                        <option value="">All stays</option>
                        <option value="trial">Trial nights only</option>
                        <option value="regular">Regular stays only</option>
                    </select>
                </label>
            }
        </form>
        <p class="muted">@Visible.Count() of @_source.Count order@( _source.Count == 1 ? "" : "s")</p>
        <div class="order-sort" aria-label="Sort orders">
            @if (_isAdmin)
            {
                <button type="button" class="chip @SortClass("customer")" @onclick='() => SortBy("customer")'>Customer @Arrow("customer")</button>
            }
            else
            {
                <button type="button" class="chip @SortClass("number")" @onclick='() => SortBy("number")'>Order @Arrow("number")</button>
            }
            <button type="button" class="chip @SortClass("when")" @onclick='() => SortBy("when")'>When @Arrow("when")</button>
            <button type="button" class="chip @SortClass("total")" @onclick='() => SortBy("total")'>Total @Arrow("total")</button>
            <button type="button" class="chip @SortClass("status")" @onclick='() => SortBy("status")'>Status @Arrow("status")</button>
        </div>
        <div class="order-cards">
            @foreach (var order in Visible)
            {
                <article class="order-card">
                    <button type="button" class="order-card__main" @onclick="() => OpenOrder(order)">
                        <div class="order-card__who">
                            <strong>@(_isAdmin ? order.CustomerName : order.OrderNumber)</strong>
                            <span class="muted">@(_isAdmin ? order.PickupDate.ToString("ddd d MMM") : $"{order.PickupDate:ddd d MMM} · {order.PickupWindow}")</span>
                        </div>
                        <div class="order-card__meta">
                            <span class="order-card__total">@CatalogFormatting.Money(order.Total)</span>
                            <span class="order-pill order-pill--@StatusTone(order)">@order.StatusLabel</span>
                        </div>
                    </button>
                    @if (HasListActions(order))
                    {
                        <div class="order-card__actions">
                            @if (_isAdmin && order.CanApprove)
                            {
                                <button class="btn btn--solid" type="button" disabled="@(_acting == order.Id)" @onclick="() => ApproveAsync(order)">Approve</button>
                            }
                            @if (_isAdmin && order.CanReject)
                            {
                                <button class="btn btn--ghost" type="button" disabled="@(_acting == order.Id)" @onclick="() => RejectAsync(order)">Reject</button>
                            }
                            @if (!_isAdmin && order.CanPay && !_needsSquareKeys)
                            {
                                <button class="btn btn--solid" type="button" disabled="@(_paying == order.OrderNumber)" @onclick="() => PayAsync(order)">Pay online</button>
                            }
                            @if (order.AlbumId is int albumId)
                            {
                                <a class="btn btn--ghost" href="/albums/@albumId">Album</a>
                            }
                        </div>
                    }
                </article>
            }
        </div>
        <div class="table-scroll orders-desktop">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th><button type="button" class="sort-btn" @onclick='() => SortBy("number")'>Order @Arrow("number")</button></th>
                        @if (_isAdmin)
                        {
                            <th><button type="button" class="sort-btn" @onclick='() => SortBy("customer")'>Customer @Arrow("customer")</button></th>
                            <th><button type="button" class="sort-btn" @onclick='() => SortBy("phone")'>Phone @Arrow("phone")</button></th>
                        }
                        <th><button type="button" class="sort-btn" @onclick='() => SortBy("when")'>When @Arrow("when")</button></th>
                        <th>Items</th>
                        <th><button type="button" class="sort-btn" @onclick='() => SortBy("total")'>Total @Arrow("total")</button></th>
                        <th><button type="button" class="sort-btn" @onclick='() => SortBy("status")'>Status @Arrow("status")</button></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Visible)
                    {
                        <tr>
                            <td>
                                <a class="text-link" href="@OrderHref(order)">@order.OrderNumber</a>
                                @if (order.CanPay)
                                {
                                    <div class="muted">Unpaid</div>
                                }
                            </td>
                            @if (_isAdmin)
                            {
                                <td>
                                    @order.CustomerName
                                    <div class="muted">@order.CustomerEmail</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(order.Phone) ? "—" : order.Phone)</td>
                            }
                            <td>@order.PickupDate.ToString("ddd d MMM") · @order.PickupWindow</td>
                            <td>
                                @foreach (var line in order.Items)
                                {
                                    <div>@line.Quantity × @line.ProductName</div>
                                    @if (line.IsTrialStay)
                                    {
                                        <div class="muted">Free trial night</div>
                                    }
                                    else if (line.IntendedStayStartsAt is not null)
                                    {
                                        <div class="muted">Confirmed after trial</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(line.SlotLabel))
                                    {
                                        <div class="muted">@line.SlotLabel</div>
                                    }
                                    @if (line.IsTrialStay && line.IntendedStayStartsAt is not null && line.IntendedStayEndsAt is not null)
                                    {
                                        <div class="muted">Wanted stay: @StayRange(line.IntendedStayStartsAt.Value, line.IntendedStayEndsAt.Value)</div>
                                    }
                                }
                            </td>
                            <td>@CatalogFormatting.Money(order.Total)</td>
                            <td>
                                <div>@order.StatusLabel</div>
                                @if (!_isAdmin && !string.IsNullOrWhiteSpace(order.CustomerNote))
                                {
                                    <div class="muted">@order.CustomerNote</div>
                                }
                            </td>
                            <td>
                                <div class="order-actions">
                                    @if (_isAdmin && order.CanApprove)
                                    {
                                        <button class="btn btn--solid" type="button" disabled="@(_acting == order.Id)" @onclick="() => ApproveAsync(order)">Approve</button>
                                    }
                                    @if (_isAdmin && order.CanReject)
                                    {
                                        <button class="btn btn--ghost" type="button" disabled="@(_acting == order.Id)" @onclick="() => RejectAsync(order)">Reject</button>
                                    }
                                    @if (_isAdmin && order.CanPlaceOriginalStay)
                                    {
                                        <button class="btn btn--solid" type="button" disabled="@(_acting == order.Id)" @onclick="() => PlaceOriginalAsync(order)">Place original order</button>
                                    }
                                    @if (_isAdmin && order.CanDeclineLongerStay)
                                    {
                                        <button class="btn btn--ghost" type="button" disabled="@(_acting == order.Id)" @onclick="() => DeclineLongerStayAsync(order)">Do not continue</button>
                                    }
                                    @if (!_isAdmin && order.CanPay && !_needsSquareKeys)
                                    {
                                        <button class="btn btn--solid" type="button" disabled="@(_paying == order.OrderNumber)" @onclick="() => PayAsync(order)">Pay online</button>
                                    }
                                    @if (order.AlbumId is int albumId)
                                    {
                                        <a class="text-link" href="/albums/@albumId">Open album</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Visible.Any())
        {
            <p class="muted">No orders match those filters.</p>
        }
    }
</section>

@if (Opened is not null)
{
    var order = Opened;
    <div class="order-sheet" @onclick="CloseOrder">
        <div class="order-sheet__panel" @onclick:stopPropagation="true">
            <div class="order-sheet__grab" aria-hidden="true"></div>
            <div class="order-sheet__head">
                <div>
                    <p class="eyebrow">@order.OrderNumber</p>
                    <h2>@(_isAdmin ? order.CustomerName : "Your order")</h2>
                </div>
                <button type="button" class="text-link" @onclick="CloseOrder">Close</button>
            </div>
            <div class="order-sheet__status">
                <span class="order-pill order-pill--@StatusTone(order)">@order.StatusLabel</span>
                <strong class="order-card__total">@CatalogFormatting.Money(order.Total)</strong>
            </div>
            @if (_isAdmin)
            {
                <p class="muted">@order.CustomerEmail</p>
                @if (!string.IsNullOrWhiteSpace(order.Phone))
                {
                    <p>@order.Phone</p>
                }
            }
            <p>Visit / collect @order.PickupDate.ToString("dddd d MMMM") · @order.PickupWindow</p>
            @if (!string.IsNullOrWhiteSpace(order.CustomerNote))
            {
                <p class="muted">@order.CustomerNote</p>
            }
            <ul class="order-sheet__items">
                @foreach (var line in order.Items)
                {
                    <li>
                        <span>@line.Quantity × @line.ProductName</span>
                        <span>@CatalogFormatting.Money(line.UnitPrice * line.Quantity)</span>
                        @if (line.IsTrialStay)
                        {
                            <small class="muted">Free trial night</small>
                        }
                        else if (line.IntendedStayStartsAt is not null)
                        {
                            <small class="muted">Confirmed after trial</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(line.SlotLabel))
                        {
                            <small class="muted">@line.SlotLabel</small>
                        }
                        @if (line.IsTrialStay && line.IntendedStayStartsAt is not null && line.IntendedStayEndsAt is not null)
                        {
                            <small class="muted">Wanted stay: @StayRange(line.IntendedStayStartsAt.Value, line.IntendedStayEndsAt.Value)</small>
                        }
                    </li>
                }
            </ul>
            <div class="order-sheet__actions">
                @if (_isAdmin && order.CanApprove)
                {
                    <button class="btn btn--solid" type="button" disabled="@(_acting == order.Id)" @onclick="() => ApproveAsync(order)">Approve</button>
                }
                @if (_isAdmin && order.CanReject)
                {
                    <button class="btn btn--ghost" type="button" disabled="@(_acting == order.Id)" @onclick="() => RejectAsync(order)">Reject</button>
                }
                @if (_isAdmin && order.CanPlaceOriginalStay)
                {
                    <button class="btn btn--solid" type="button" disabled="@(_acting == order.Id)" @onclick="() => PlaceOriginalAsync(order)">Place original order</button>
                }
                @if (_isAdmin && order.CanDeclineLongerStay)
                {
                    <button class="btn btn--ghost" type="button" disabled="@(_acting == order.Id)" @onclick="() => DeclineLongerStayAsync(order)">Do not continue</button>
                }
                @if (!_isAdmin && order.CanPay && !_needsSquareKeys)
                {
                    <button class="btn btn--solid" type="button" disabled="@(_paying == order.OrderNumber)" @onclick="() => PayAsync(order)">Pay online</button>
                }
                @if (order.AlbumId is int albumId)
                {
                    <a class="btn btn--ghost" href="/albums/@albumId">Open album</a>
                }
                @if (_isAdmin)
                {
                    <a class="text-link" href="@OrderHref(order)">Open full order</a>
                }
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<OrderSummary> _source = [];
    private bool _isAdmin;
    private string _orderNumber = string.Empty;
    private string _firstName = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _status = string.Empty;
    private DateTime? _fromDate;
    private string _trialFilter = string.Empty;
    private string _sort = "when";
    private bool _asc;
    private string? _paying;
    private int? _acting;
    private int? _openId;
    private OrderSummary? Opened =>
        _openId is int id ? _source.FirstOrDefault(o => o.Id == id) : null;
    private StoreOptions Store => StoreAccessor.Value;
    private bool _needsSquareKeys =>
        PaymentAccessor.Value.Provider.Equals("Square", StringComparison.OrdinalIgnoreCase)
        && !PaymentAccessor.Value.Square.IsConfigured;

    private IEnumerable<OrderSummary> Visible
    {
        get
        {
            IEnumerable<OrderSummary> rows = _source;
            if (HasText(_orderNumber))
            {
                rows = rows.Where(o => Contains(o.OrderNumber, _orderNumber));
            }

            if (_isAdmin && HasText(_firstName))
            {
                rows = rows.Where(o => Contains(FirstName(o.CustomerName), _firstName));
            }

            if (_isAdmin && HasText(_email))
            {
                rows = rows.Where(o => Contains(o.CustomerEmail, _email));
            }

            if (_isAdmin && HasText(_phone))
            {
                rows = rows.Where(o => Contains(Digits(o.Phone), Digits(_phone)) || Contains(o.Phone, _phone));
            }

            if (Enum.TryParse<OrderStatus>(_status, out var status))
            {
                rows = rows.Where(o => o.Status.VisibleStatus() == status);
            }

            if (_fromDate is DateTime from)
            {
                var day = DateOnly.FromDateTime(from);
                rows = rows.Where(o => o.PickupDate >= day);
            }

            if (_isAdmin && _trialFilter == "trial")
            {
                rows = rows.Where(o => o.HasTrialStay);
            }
            else if (_isAdmin && _trialFilter == "regular")
            {
                rows = rows.Where(o => !o.HasTrialStay);
            }

            return _sort switch
            {
                "number" => Order(rows, o => o.OrderNumber),
                "customer" => Order(rows, o => o.CustomerName),
                "phone" => Order(rows, o => o.Phone ?? string.Empty),
                "total" => Order(rows, o => o.Total),
                "status" => Order(rows, o => o.Status.DisplayName()),
                _ => Order(rows, o => o.PickupDate)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("Please sign in again.");
        _isAdmin = state.User.IsInRole(AppRoles.Admin);
        _source = _isAdmin
            ? await Orders.GetAllAsync()
            : await Orders.GetMineAsync(userId);
    }

    private void SortBy(string column)
    {
        if (_sort == column)
        {
            _asc = !_asc;
            return;
        }

        _sort = column;
        _asc = column is "number" or "customer";
    }

    private string Arrow(string column) =>
        _sort == column ? (_asc ? "↑" : "↓") : "";

    private string SortClass(string column) =>
        _sort == column ? "chip--active" : string.Empty;

    private void OpenOrder(OrderSummary order) => _openId = order.Id;

    private void CloseOrder() => _openId = null;

    private bool HasListActions(OrderSummary order) =>
        (_isAdmin && (order.CanApprove || order.CanReject))
        || (!_isAdmin && order.CanPay && !_needsSquareKeys)
        || order.AlbumId is not null;

    private static string StatusTone(OrderSummary order) =>
        order.Status.IsRejected() ? "no"
        : order.Status.IsApproved() ? "ok"
        : "wait";

    private string OrderHref(OrderSummary order) =>
        _isAdmin ? $"/admin/orders/{order.OrderNumber}" : $"/checkout/confirmation/{order.OrderNumber}";

    private async Task ApproveAsync(OrderSummary order)
    {
        await RunAdminActionAsync(order.Id, () => Orders.ApproveAsync(order.Id), "Order approved.");
    }

    private async Task RejectAsync(OrderSummary order)
    {
        await RunAdminActionAsync(order.Id, () => Orders.RejectAsync(order.Id), "Order rejected.");
    }

    private async Task PlaceOriginalAsync(OrderSummary order)
    {
        _acting = order.Id;
        try
        {
            await Orders.PlaceOriginalStayAsync(order.Id);
            _trialFilter = string.Empty;
            _status = string.Empty;
            _orderNumber = order.OrderNumber;
            Snackbar.Add($"{order.OrderNumber} is now an approved stay. The customer can pay as usual.", Severity.Success);
            _source = await Orders.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _acting = null;
        }
    }

    private async Task DeclineLongerStayAsync(OrderSummary order)
    {
        await RunAdminActionAsync(order.Id, () => Orders.RejectAsync(order.Id), "We will not continue with the longer stay.");
    }

    private async Task RunAdminActionAsync(int orderId, Func<Task> action, string ok)
    {
        _acting = orderId;
        try
        {
            await action();
            Snackbar.Add(ok, Severity.Success);
            _source = await Orders.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _acting = null;
        }
    }

    private static string StayRange(DateTimeOffset start, DateTimeOffset end)
    {
        var dropOff = start.ToOffset(BookingPricing.SydneyOffset(start));
        var pickUp = end.ToOffset(BookingPricing.SydneyOffset(end));
        return $"{dropOff:ddd d MMM} – {pickUp:ddd d MMM}";
    }

    private async Task PayAsync(OrderSummary order)
    {
        _paying = order.OrderNumber;
        try
        {
            var payment = await Payment.CreatePaymentAsync(PaymentFlow.ForOrder(order, Store.Currency));
            Navigation.NavigateTo(payment.RedirectUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            _paying = null;
        }
    }

    private IEnumerable<OrderSummary> Order<T>(IEnumerable<OrderSummary> rows, Func<OrderSummary, T> key) =>
        _asc ? rows.OrderBy(key) : rows.OrderByDescending(key);

    private static string FirstName(string name)
    {
        var trimmed = name.Trim();
        var space = trimmed.IndexOf(' ');
        return space < 0 ? trimmed : trimmed[..space];
    }

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value);

    private static bool Contains(string? value, string query) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string Digits(string? value) =>
        string.IsNullOrWhiteSpace(value) ? string.Empty : new string(value.Where(char.IsDigit).ToArray());
}
