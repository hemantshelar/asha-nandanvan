# SQL / Docker host settings only. Do not put Google, Square, or admin keys here.
# Those stay in src/AshaNandanvan.Web/secrets.json (or .NET user secrets).
# The "https (Docker SQL)" profile sets ASHA_SQL_SOURCE=docker so only the
# connection string is overridden; secrets.json is left unchanged.

# Required. Must meet SQL Server complexity rules.
MSSQL_SA_PASSWORD=Your_password123

# Used by docker compose and by host debug (ASHA_SQL_SOURCE=docker).
SQL_DATABASE=ashanandanvan-dev
SQL_USER=sa

# Host debug talks to the published port. Compose overrides this to sql,1433 inside the web container.
SQL_SERVER=127.0.0.1,1433
SQL_ENCRYPT=True
SQL_TRUST_SERVER_CERTIFICATE=True
SQL_MULTIPLE_ACTIVE_RESULT_SETS=true

# Local process defaults. Azure App Service sets Production.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
