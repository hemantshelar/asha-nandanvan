# Copy to .env. Do not commit .env.
# Names match Azure App Service settings.

# SQL (required for the container and for https (Docker SQL) on the host)
MSSQL_SA_PASSWORD=Your_password123
SQL_DATABASE=ashanandanvan-dev
SQL_USER=sa
SQL_SERVER=127.0.0.1,1433
SQL_ENCRYPT=True
SQL_TRUST_SERVER_CERTIFICATE=True
SQL_MULTIPLE_ACTIVE_RESULT_SETS=true

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# App secrets. Docker compose loads these into the web container.
# Host debug can keep the same values in secrets.json or user secrets.
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=
Admin__SeedEmail=

Payment__Provider=Square
Payment__Square__ApplicationId=
Payment__Square__AccessToken=
Payment__Square__LocationId=
Payment__Square__UseSandbox=true
Payment__Square__WebhookSignatureKey=
